# Copy this file to .env and set a real password.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=reli_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Python backend connection string (keep in sync with the values above)
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/reli_rag
