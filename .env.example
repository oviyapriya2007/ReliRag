# Copy this file to .env and set a real password.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=reli_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Python backend connection string (keep in sync with the values above)
DATABASE_URL=postgresql://postgres:replace_with_your_password@localhost:5432/reli_rag

# Backend API
# Title shown in the API docs (/docs)
APP_NAME=RELI-RAG API
# Browser origins allowed to call the API: a JSON array of exact origins (scheme://host:port,
# no trailing slash). Must include the frontend's URL.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Largest accepted PDF upload, in whole megabytes (1 MB = 1024 * 1024 bytes); larger files get HTTP 413
MAX_UPLOAD_MB=20

# Minimum top-1 cosine similarity before an answer is generated (temporary; calibrated in A6)
SIMILARITY_GATE=0.30

# PDF ingestion. Chunks are fixed-size character windows; CHUNK_OVERLAP must be smaller than
# CHUNK_SIZE. Changes apply to newly uploaded documents; re-upload existing ones to re-chunk.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Sentence-transformers model used for documents and questions. It must output 384-dimensional
# vectors (the database column size); changing it requires re-uploading every document.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Claude API
ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=your_claude_model_id
CLAUDE_MAX_TOKENS=1024
CLAUDE_TIMEOUT_SECONDS=60
CLAUDE_RETRY_BACKOFF_SECONDS=1.0

# Answer evaluator (CLAUDE_MAX_TOKENS above applies to answer generation only)
# Leave EVALUATOR_MODEL empty to use CLAUDE_MODEL.
EVALUATOR_MODEL=
EVALUATOR_MAX_TOKENS=2048
# Minimum faithfulness, answer relevance and context relevance (0-1) for an answer to pass
EVALUATOR_PASS_THRESHOLD=0.80
# Claude calls per evaluation when the reply is not valid JSON (1 = no retry)
EVALUATOR_MAX_PARSE_ATTEMPTS=2
